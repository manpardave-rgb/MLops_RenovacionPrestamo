# .env.example — plantilla de variables de entorno
# Copiar a .env.preprod y ajustar. NUNCA subir secretos reales al repositorio.

ENV=preprod
DEBUG=false
LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Puertos expuestos en el host / Codespace
API_PORT=8000
MLFLOW_PORT=5000

# Secreto de ejemplo — en un despliegue real, inyectar vía Secret Manager (GCP)
SECRET_KEY=changeme-example-secret